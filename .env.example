# ==============================================================================
# AI Hand Rehabilitation System - Environment Configuration Template
# Copy this file to .env to customize local configurations.
# NOTE: The system is designed to run 100% offline out of the box without .env.
# ==============================================================================

# Virtual Sensei Local LLM Coaching (Optional)
# Set to 1 to enable optional local LLM phrasing enhancement via Ollama.
# Set to 0 (default) to use 100% offline deterministic clinical rule-based coaching.
OLLAMA_SENSEI_USE_LLM=0

# Ollama Endpoint Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_SENSEI_MODEL=qwen2.5:0.5b
OLLAMA_SENSEI_FALLBACK_MODELS=smollm2:135m,llama3.2:1b,llama3
OLLAMA_SENSEI_TIMEOUT=8.0

# Clinician Admin Dashboard Settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8081
